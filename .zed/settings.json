{
  "preferred_line_length": 100,
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "rustc": {
          "source": "discover",
        },
      },
      "settings": {
        "imports": {
          "granularity": {
            "group": "module",
          },
        },
      },
    },
  },
}
